{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/svelte"],
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off"
      }
    }
  },
  // Workflows behalten die übliche YAML-Schreibweise `[main]`.
  "yaml": {
    "formatter": {
      "bracketSpacing": false
    }
  },
  "files": {
    "includes": ["!!**/src-tauri/target", "!!**/src-tauri/gen"]
  },
  "linter": {
    "rules": {
      "style": {
        "noIncrementDecrement": "off",
        "useDestructuring": "off"
      },
      "suspicious": {
        "noUnnecessaryConditions": "off",
        // Ziel sind nur WebView2 (Chromium) und WKWebView, keine beliebigen
        // Browser; user-select, scrollbar-color & Co. sind dort gesetzt.
        "useBaseline": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.svelte"],
      // Biome formatiert Ausdrücke im Svelte-Markup noch fehlerhaft eingerückt.
      "html": {
        "formatter": {
          "enabled": false
        }
      },
      "linter": {
        "rules": {
          "style": {
            // Dynamische Geometrie (virtualisierte Liste, OCR-Boxen, TOTP-Balken)
            // gehört in style-Attribute; die CSP erlaubt sie über 'unsafe-inline'.
            "noInlineStyles": "off"
          },
          "suspicious": {
            // `onclick={() => (offen = !offen)}` ist das übliche Svelte-Muster.
            "noReturnAssign": "off"
          }
        }
      }
    }
  ]
}
