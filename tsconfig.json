{
  // Modul-Auflösung, Ziel und Compiler-Grundeinstellungen kommen aus dem von
  // SvelteKit generierten $app/tsconfig.
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true
  },
  "include": ["src", "vite.config.js"],
  // Tests laufen unter `bun test`; ohne @types/bun kennt TypeScript
  // `bun:test` nicht, und @types/bun zöge Node-Globals wie `process` in den
  // Frontend-Typraum.
  "exclude": ["node_modules/**", "src/**/*.test.ts"]
}
