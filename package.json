{
  "name": "tippit",
  "version": "2.0.0",
  "description": "Tippt die Zwischenablage als Tastatureingaben — mit verschlüsselter, geräte-lokaler Historie",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "biome ci .",
    "dev": "bun run tauri dev",
    "dev:frontend": "vite dev",
    "fix": "ultracite fix",
    "prepare": "svelte-kit sync",
    "preview": "vite preview",
    "tauri": "bun scripts/tauri.js",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.11.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "ultracite": "7.12.0",
    "vite": "^8.3.0"
  },
  "packageManager": "bun@1.4.2"
}
