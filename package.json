{
  "dependencies": {
    "@tauri-apps/api": "^2",
    "convex": "^1.42.2",
    "js-sha256": "^0.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "turbo": "^2.10.5",
    "typescript": "~5.6.2",
    "ultracite": "6.4.0",
    "vite": "^6.0.3"
  },
  "name": "tippit",
  "packageManager": "bun@1.3.3",
  "scripts": {
    "dev": "turbo run dev:app dev:convex",
    "dev:app": "bun run tauri dev",
    "dev:convex": "convex dev",
    "dev:frontend": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "ultracite check && biome ci .",
    "fix": "ultracite fix",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "bun scripts/tauri.js"
  },
  "type": "module",
  "version": "0.3.0",
  "description": "Tippt die Zwischenablage als Tastatureingaben — mit verschlüsselter Historie und optionalem Sync",
  "license": "MIT"
}
