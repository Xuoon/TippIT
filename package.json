{
  "name": "tippit",
  "version": "2.3.1",
  "description": "Tippt die Zwischenablage als Tastatureingaben — mit verschlüsselter, geräte-lokaler Historie",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vite build",
    "check": "biome ci .",
    "dev": "bun run tauri dev",
    "dev:frontend": "vite dev",
    "fix": "ultracite fix",
    "prepare": "svelte-kit sync",
    "preview": "vite preview",
    "tauri": "bun scripts/tauri.js",
    "test": "bun test",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "update": "bun update --latest && cargo update --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "ultracite": "8.1.1",
    "vite": "^8.3.6"
  },
  "packageManager": "bun@1.4.4"
}
