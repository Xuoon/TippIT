{
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.11.4",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "~6.0.3",
    "ultracite": "7.9.4",
    "vite": "^8.1.5"
  },
  "name": "tippit",
  "packageManager": "bun@1.3.3",
  "scripts": {
    "dev": "bun run tauri dev",
    "dev:frontend": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "ultracite check && biome ci .",
    "fix": "ultracite fix",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "bun scripts/tauri.js"
  },
  "type": "module",
  "version": "2.0.0",
  "description": "Tippt die Zwischenablage als Tastatureingaben — mit verschlüsselter, geräte-lokaler Historie",
  "license": "MIT"
}
